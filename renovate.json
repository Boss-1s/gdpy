{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "vulnerabilityAlerts": {
        "enabled": true
    },
    "dependencyDashboard": false,
    "prConcurrentLimit": 0,
    "prHourlyLimit": 0,
    "branchPrefix": "deps/",
    "additionalBranchPrefix": "main/",
    "ignorePaths": [],
    "includePaths": ["**"],
}
